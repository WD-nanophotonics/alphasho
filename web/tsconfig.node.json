  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "scripts", "src/engine", "src/player/nnue-config.ts", "src/player/rook-guide.ts"]
}
